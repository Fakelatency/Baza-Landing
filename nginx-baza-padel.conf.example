# Przykładowa konfiguracja Nginx dla domeny baza-padel.pl
# Ścieżka na serwerze: /etc/nginx/sites-available/baza-padel.pl

server {
    listen 80;
    listen [::]:80;
    server_name baza-padel.pl www.baza-padel.pl;

    # Przekierowanie całego ruchu HTTP na HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name baza-padel.pl www.baza-padel.pl;

    # Certyfikaty SSL (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/baza-padel.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baza-padel.pl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Kompresja gzip dla szybszego ładowania
    gzip on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # ==========================================================
    # 1. ISTNIEJĄCA APLIKACJA TURNIEJOWA (ZACHOWAJ SWOJE USTAWIENIA)
    # ==========================================================
    location /turnieje {
        # Zastąp 3000 portem, na którym faktycznie działa aplikacja turniejowa
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==========================================================
    # 2. NOWA APLIKACJA LANDING PAGE (PORT 3001)
    # ==========================================================
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache dla statycznych zasobów Next.js
    location /_next/static {
        proxy_pass http://127.0.0.1:3001;
        proxy_cache_bypass $http_upgrade;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
